{
  "expo": {
    "name": "Food Slot",
    "slug": "food-slot-machine",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "foodslot",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.ferdinands.foodslot",
      "infoPlist": {
        "NSMotionUsageDescription": "Food Slot nutzt Bewegungsdaten, damit du die Slots mit einem Vorwärtsschub starten kannst."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A2E24",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#1E1729"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Food Slot nutzt Bewegungsdaten, damit du die Slots mit einem Vorwärtsschub starten kannst."
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "uppercasef",
    "extra": {
      "eas": {
        "projectId": "074554b7-3bfe-4195-ae61-8e775d0abb07"
      }
    }
  }
}
